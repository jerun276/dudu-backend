# CupidLearn (.NET) environment variables
# Copy to a local .env (do not commit) OR set these in your hosting environment.

# ----------------------------
# SMTP (for OTP email)
# ASP.NET Core maps `Smtp__Host` to configuration section `Smtp:Host`
# ----------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true

# For Gmail, use an App Password (not your normal password)
Smtp__User=your-email@gmail.com
Smtp__Pass=your-app-password

Smtp__FromEmail=your-email@gmail.com
Smtp__FromName=CupidLearn
