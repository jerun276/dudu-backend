<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\AppDbContext.cs" />
    <Compile Remove="Domain\**\*.cs" />
    <Compile Remove="Infrastructure\Seeding\**\*.cs" />
    <Compile Remove="Infrastructure\JwtOptions.cs" />
    <Compile Remove="Infrastructure\JwtModule.cs" />
    <Compile Remove="Infrastructure\JwtTokenService.cs" />
    <Compile Remove="Migrations\**\*.cs" />
    <Compile Remove="Controllers\ContentController.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CupidLearn.Application\CupidLearn.Application.csproj" />
    <ProjectReference Include="..\CupidLearn.Infrastructure\CupidLearn.Infrastructure.csproj" />
    <ProjectReference Include="..\CupidLearn.Domain\CupidLearn.Domain.csproj" />
  </ItemGroup>

</Project>
