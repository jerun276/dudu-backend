@model CupidLearn.Web.Models.LoginViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CupidLearn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: radial-gradient(1200px 600px at 0% 0%, #eef2ff 0%, #f6f8fb 50%, #ffffff 100%); }
        .card { border: 0; box-shadow: 0 18px 60px rgba(17,24,39,.12); }
        .brand { letter-spacing: .3px; }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="text-center mb-4">
                <div class="fw-bold brand" style="font-size: 28px;">CupidLearn</div>
                <div class="text-muted">Admin Console</div>
            </div>

            <div class="card p-4">
                <div class="mb-3">
                    <div class="fw-semibold">Sign in</div>
                    <div class="text-muted small">Use your admin credentials</div>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="admin@cupid.local" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button class="btn btn-dark w-100" type="submit">Login</button>
                </form>

                <hr />
                <div class="small text-muted">
                    Default admin:
                    <div><span class="fw-semibold">admin@cupid.local</span></div>
                    <div><span class="fw-semibold">AdminPassword123!</span></div>
                </div>
            </div>

            <div class="text-center mt-3 small text-muted">
                API Base URL: @Configuration["Api:BaseUrl"]
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
