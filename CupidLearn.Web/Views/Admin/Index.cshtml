@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card p-4">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <div class="fw-semibold">Welcome back</div>
                    <div class="text-muted small">Use the navigation to manage content, subscriptions, organizations and seats.</div>
                </div>
                <span class="badge text-bg-dark">Admin</span>
            </div>

            <hr />

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="text-muted small">Content</div>
                        <div class="fw-semibold">Levels • Modules • Lessons</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="text-muted small">Assessment</div>
                        <div class="fw-semibold">Quizzes • Questions</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="text-muted small">Billing</div>
                        <div class="fw-semibold">Subscriptions • Seats</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card p-4">
            <div class="fw-semibold mb-2">Quick actions</div>
            <div class="d-grid gap-2">
                <a class="btn btn-outline-dark" href="#">Create Module</a>
                <a class="btn btn-outline-dark" href="#">Create Lesson</a>
                <a class="btn btn-outline-dark" href="#">Create Organization</a>
            </div>
        </div>
    </div>
</div>
