@model CupidLearn.Web.Models.Billing.BillingIndexViewModel
@{
    ViewData["Title"] = "Billing";
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="bg-red-50 border border-red-200 text-red-600 text-sm px-4 py-3 rounded-xl mb-4">@Model.Error</div>
}

<div class="space-y-5">

    <!-- Top row: Organizations + Seats -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

        <!-- Organizations -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-800">Organizations</h2>
                <p class="text-xs text-slate-400 mt-0.5">Create a new organization or load seats by ID</p>
            </div>
            <div class="p-5 space-y-4">
                <!-- Create org form -->
                <form asp-action="CreateOrganization" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1.5">Organization Name</label>
                        <input name="Name" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-slate-400" placeholder="School / Institute" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1.5">Seat Count <span class="text-slate-400">(optional)</span></label>
                        <input name="SeatCount" type="number" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-slate-400" placeholder="0" />
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2.5 rounded-xl transition-colors">
                        Create Organization
                    </button>
                </form>

                <div class="border-t border-slate-100 pt-4">
                    <form method="get" class="space-y-3">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1.5">Load Seats by Organization ID</label>
                            <input name="organizationId" value="@Model.OrganizationId"
                                   class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-slate-400 font-mono"
                                   placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                        </div>
                        <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium py-2.5 rounded-xl transition-colors">
                            Load Seats
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Seats -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-slate-800">Seats</h2>
                    <p class="text-xs text-slate-400 mt-0.5">
                        @(Model.OrganizationId != null ? $"Org: {Model.OrganizationId}" : "No organization selected")
                    </p>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-xs font-medium">
                    @Model.Seats.Count seats
                </span>
            </div>
            <div class="p-5">
                @if (Model.OrganizationId == null)
                {
                    <div class="text-center py-8">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-2">
                            <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <p class="text-sm text-slate-400">Enter an organization ID to view seats</p>
                    </div>
                }
                else
                {
                    <!-- Assign / Revoke -->
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <form asp-action="AssignSeat" method="post" class="bg-indigo-50 rounded-xl p-3 space-y-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
                            <div class="text-xs font-semibold text-indigo-700">Assign Seat</div>
                            <input name="UserId" class="w-full border border-indigo-200 bg-white rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono" placeholder="User ID" />
                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium py-1.5 rounded-lg transition-colors">Assign</button>
                        </form>
                        <form asp-action="RevokeSeat" method="post" class="bg-red-50 rounded-xl p-3 space-y-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
                            <div class="text-xs font-semibold text-red-700">Revoke Seat</div>
                            <input name="UserId" class="w-full border border-red-200 bg-white rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-red-400 font-mono" placeholder="User ID" />
                            <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white text-xs font-medium py-1.5 rounded-lg transition-colors">Revoke</button>
                        </form>
                    </div>

                    <!-- Seats Table -->
                    <div class="overflow-x-auto rounded-xl border border-slate-100">
                        <table class="w-full text-sm">
                            <thead class="bg-slate-50 border-b border-slate-100">
                                <tr>
                                    <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-2.5">Status</th>
                                    <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-2.5">User ID</th>
                                    <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-2.5">Seat ID</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                @foreach (var s in Model.Seats)
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="px-4 py-2.5">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-800 text-white text-xs font-medium">@s.Status</span>
                                        </td>
                                        <td class="px-4 py-2.5 text-slate-400 text-xs font-mono">@s.UserId</td>
                                        <td class="px-4 py-2.5 text-slate-400 text-xs font-mono">@s.Id</td>
                                    </tr>
                                }
                                @if (!Model.Seats.Any())
                                {
                                    <tr><td colspan="3" class="px-4 py-6 text-center text-slate-400 text-sm">No seats found</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Subscription Manager -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-800">Subscription Manager</h2>
            <p class="text-xs text-slate-400 mt-0.5">Look up a user's subscription plan and limits, or upsert their subscription</p>
        </div>
        <div class="p-5">
            <!-- User ID lookup -->
            <form method="get" class="flex gap-2 mb-5">
                <input name="userId" value="@Model.UserId"
                       class="flex-1 border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-slate-400 font-mono"
                       placeholder="Enter User ID (GUID)..." />
                <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">
                    Load
                </button>
            </form>

            @if (Model.UserId != null)
            {
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <!-- Plan Info -->
                    <div class="bg-slate-50 rounded-xl p-4">
                        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Plan Summary</h3>
                        <div class="space-y-2">
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">Plan</span>
                                <span class="text-sm font-semibold text-slate-800">@Model.Limits?.Plan</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">Max Orgs</span>
                                <span class="text-sm font-medium">@Model.Limits?.MaxOrganizations</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">Max Seats/Org</span>
                                <span class="text-sm font-medium">@Model.Limits?.MaxSeatsPerOrganization</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">Max Children</span>
                                <span class="text-sm font-medium">@Model.Limits?.MaxChildren</span>
                            </div>
                        </div>
                        @if (Model.Subscription != null)
                        {
                            <div class="mt-3 pt-3 border-t border-slate-200">
                                <div class="text-xs text-slate-400">Current</div>
                                <div class="text-sm font-medium text-slate-700">@Model.Subscription.Provider <span class="text-slate-400">(@Model.Subscription.Status)</span></div>
                                <div class="text-xs text-slate-400 font-mono truncate">@Model.Subscription.ProviderSubscriptionId</div>
                            </div>
                        }
                    </div>

                    <!-- Upsert Form -->
                    <div class="lg:col-span-2">
                        <form asp-action="UpsertSubscription" method="post" class="bg-indigo-50 rounded-xl p-4 space-y-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="UserId" value="@Model.UserId" />
                            <h3 class="text-xs font-semibold text-indigo-700 uppercase tracking-wide">Upsert Subscription</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <div>
                                    <label class="block text-xs font-medium text-slate-600 mb-1.5">Provider</label>
                                    <input name="Provider" value="stripe"
                                           class="w-full border border-indigo-200 bg-white rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-600 mb-1.5">Subscription ID</label>
                                    <input name="ProviderSubscriptionId"
                                           class="w-full border border-indigo-200 bg-white rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono"
                                           placeholder="sub_..." />
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-600 mb-1.5">Status</label>
                                    <select name="Status" class="w-full border border-indigo-200 bg-white rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                        <option value="ACTIVE">ACTIVE</option>
                                        <option value="TRIALING">TRIALING</option>
                                        <option value="CANCELED">CANCELED</option>
                                        <option value="PAST_DUE">PAST_DUE</option>
                                        <option value="INCOMPLETE">INCOMPLETE</option>
                                        <option value="UNPAID">UNPAID</option>
                                    </select>
                                </div>
                            </div>
                            <div class="flex justify-end">
                                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">
                                    Save Subscription
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
