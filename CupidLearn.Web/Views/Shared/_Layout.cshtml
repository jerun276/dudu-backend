<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CupidLearn Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { DEFAULT: '#4f46e5', light: '#eef2ff', dark: '#3730a3' }
                    }
                }
            }
        }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-screen overflow-hidden flex" x-data="{ sidebarOpen: true }">

    <!-- Sidebar -->
    <aside class="bg-white border-r border-slate-200 flex flex-col transition-all duration-300 z-30 flex-shrink-0"
           :class="sidebarOpen ? 'w-64' : 'w-16'">

        <!-- Brand -->
        <div class="flex items-center gap-3 px-4 py-5 border-b border-slate-100">
            <div class="w-8 h-8 rounded-xl bg-indigo-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
            </div>
            <div x-show="sidebarOpen" x-cloak x-transition.opacity>
                <div class="font-bold text-slate-900 text-sm leading-tight">CupidLearn</div>
                <div class="text-xs text-slate-400">Admin Console</div>
            </div>
        </div>

        <!-- Nav Links -->
        <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }

            <!-- Dashboard -->
            <a asp-controller="Admin" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors @(ctrl == "Admin" ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span x-show="sidebarOpen" x-cloak>Dashboard</span>
            </a>

            <!-- Content -->
            <a asp-controller="Content" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors @(ctrl == "Content" ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                <span x-show="sidebarOpen" x-cloak>Content</span>
            </a>

            <!-- Billing -->
            <a asp-controller="Billing" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors @(ctrl == "Billing" ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
                <span x-show="sidebarOpen" x-cloak>Billing</span>
            </a>

            <!-- Users -->
            <a asp-controller="Users" asp-action="Index"
               class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors @(ctrl == "Users" ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span x-show="sidebarOpen" x-cloak>Users</span>
            </a>
        </nav>

        <!-- Footer: user + logout -->
        <div class="p-3 border-t border-slate-100">
            <div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-slate-50">
                <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold flex-shrink-0">
                    A
                </div>
                <div x-show="sidebarOpen" x-cloak class="flex-1 min-w-0">
                    <div class="text-xs font-medium text-slate-700 truncate">@User?.Identity?.Name</div>
                    <div class="text-xs text-slate-400">Admin</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" x-show="sidebarOpen" x-cloak>
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Logout"
                            class="text-slate-400 hover:text-red-500 transition-colors">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 flex flex-col overflow-hidden">

        <!-- Topbar -->
        <header class="bg-white border-b border-slate-200 px-6 py-3.5 flex items-center gap-4 flex-shrink-0">
            <!-- Sidebar toggle -->
            <button @@click="sidebarOpen = !sidebarOpen"
                    class="text-slate-400 hover:text-slate-700 transition-colors">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <div class="flex-1">
                <h1 class="text-sm font-semibold text-slate-900">@ViewData["Title"]</h1>
            </div>

            <div class="text-xs text-slate-400 hidden sm:block">CupidLearn Admin Console</div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto p-6">
            @RenderBody()
        </main>
    </div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
