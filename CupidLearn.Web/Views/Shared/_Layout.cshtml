<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CupidLearn Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CupidLearn.Web.styles.css" asp-append-version="true" />
    <style>
        body { background: #f6f8fb; }
        .sidebar { width: 280px; }
        .brand-dot { width: 10px; height: 10px; border-radius: 999px; background: #4f46e5; display:inline-block; }
        .nav-pills .nav-link.active { background: #111827; }
        .card { border: 0; box-shadow: 0 10px 30px rgba(17,24,39,.06); }
    </style>
</head>
<body>
<div class="d-flex">
    <aside class="sidebar border-end bg-white min-vh-100 p-3">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="brand-dot"></span>
            <div>
                <div class="fw-bold">CupidLearn</div>
                <div class="text-muted small">Admin Console</div>
            </div>
        </div>

        <nav class="nav nav-pills flex-column gap-1">
            <a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
            <a class="nav-link" asp-controller="Content" asp-action="Index">Content</a>
            <a class="nav-link" asp-controller="Billing" asp-action="Index">Billing</a>
            <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
        </nav>

        <hr />

        <div class="d-flex align-items-center justify-content-between">
            <div class="small text-muted">@User?.Identity?.Name</div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-dark" type="submit">Logout</button>
            </form>
        </div>
    </aside>

    <main class="flex-grow-1">
        <header class="border-bottom bg-white">
            <div class="container-fluid py-3 px-4 d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">@ViewData["Title"]</div>
                    <div class="text-muted small">Manage content, users, subscriptions and seats</div>
                </div>
            </div>
        </header>

        <div class="container-fluid p-4">
            @RenderBody()
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
