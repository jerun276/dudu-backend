@model CupidLearn.Web.Models.Users.UsersIndexViewModel
@{
    ViewData["Title"] = "Users";
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="bg-red-50 border border-red-200 text-red-600 text-sm px-4 py-3 rounded-xl mb-4">@Model.Error</div>
}

<div class="flex flex-col lg:flex-row gap-5">

    <!-- Left: Search + Table -->
    <div class="flex-1 min-w-0">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-slate-800">User Search</h2>
                    <p class="text-xs text-slate-400 mt-0.5">Search by email or phone number</p>
                </div>
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 text-xs font-medium">
                    @Model.Total users
                </span>
            </div>

            <div class="p-5">
                <form method="get" class="flex gap-2 mb-5">
                    <input name="query" value="@Model.Query"
                           class="flex-1 border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent placeholder-slate-400"
                           placeholder="Search by email or phone..." />
                    <button type="submit"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">
                        Search
                    </button>
                </form>

                <div class="overflow-x-auto rounded-xl border border-slate-100">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-50 border-b border-slate-100">
                            <tr>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-3">User</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-3">Phone</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-3">Role</th>
                                <th class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wide px-4 py-3">User ID</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var u in Model.Items)
                            {
                                var isSelected = Model.Summary?.UserId == u.UserId;
                                <tr class="hover:bg-slate-50 transition-colors @(isSelected ? "bg-indigo-50" : "")">
                                    <td class="px-4 py-3">
                                        <a href="@Url.Action("Index", new { query = Model.Query, userId = u.UserId })"
                                           class="font-medium text-indigo-600 hover:text-indigo-800">@u.Email</a>
                                        @if (!string.IsNullOrWhiteSpace(u.FullName))
                                        {
                                            <div class="text-xs text-slate-400">@u.FullName</div>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-slate-500 text-xs font-mono">@u.PhoneNumber</td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-900 text-white text-xs font-medium">@u.Role</span>
                                    </td>
                                    <td class="px-4 py-3 text-slate-400 text-xs font-mono truncate max-w-[150px]">@u.UserId</td>
                                </tr>
                            }
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="4" class="px-4 py-8 text-center text-slate-400 text-sm">
                                        No users found. Try searching above.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: User Detail -->
    <div class="w-full lg:w-96 flex-shrink-0">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-800">User Details</h2>
            </div>
            <div class="p-5">
                @if (Model.Summary == null)
                {
                    <div class="text-center py-8">
                        <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <p class="text-sm text-slate-400">Click a user to view their details</p>
                    </div>
                }
                else
                {
                    <!-- User Info -->
                    <div class="bg-indigo-50 rounded-xl p-4 mb-4">
                        <div class="font-semibold text-slate-800 text-sm">@Model.Summary.Email</div>
                        <div class="text-xs text-slate-400 font-mono mt-0.5">@Model.Summary.UserId</div>
                        <div class="flex items-center gap-2 mt-2">
                            <span class="inline-flex px-2 py-0.5 rounded-md bg-slate-800 text-white text-xs font-medium">@Model.Summary.Role</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Summary.FullName))
                            {
                                <span class="text-xs text-slate-500">@Model.Summary.FullName</span>
                            }
                        </div>
                    </div>

                    <!-- Subscription Limits -->
                    <div class="mb-4">
                        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Plan Limits</h3>
                        <div class="space-y-1">
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Plan</span>
                                <span class="font-medium text-slate-800">@Model.Summary.Limits.Plan</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Max Orgs</span>
                                <span class="font-medium text-slate-800">@Model.Summary.Limits.MaxOrganizations</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Max Seats/Org</span>
                                <span class="font-medium text-slate-800">@Model.Summary.Limits.MaxSeatsPerOrganization</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-slate-500">Max Children</span>
                                <span class="font-medium text-slate-800">@Model.Summary.Limits.MaxChildren</span>
                            </div>
                        </div>
                    </div>

                    <!-- Subscription -->
                    <div class="mb-4">
                        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Subscription</h3>
                        @if (Model.Summary.Subscription == null)
                        {
                            <div class="text-sm text-slate-400">No subscription found.</div>
                        }
                        else
                        {
                            <div class="bg-emerald-50 rounded-xl p-3">
                                <div class="text-sm font-medium text-emerald-700">@Model.Summary.Subscription.Provider</div>
                                <div class="text-xs text-emerald-600">@Model.Summary.Subscription.Status</div>
                                <div class="text-xs text-slate-400 font-mono mt-1">@Model.Summary.Subscription.ProviderSubscriptionId</div>
                            </div>
                        }
                    </div>

                    <!-- Seat Assignments -->
                    @if (Model.Summary.SeatAssignments.Any())
                    {
                        <div class="mb-4">
                            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Seat Assignments</h3>
                            <div class="space-y-1.5">
                                @foreach (var s in Model.Summary.SeatAssignments)
                                {
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-white text-xs font-medium">@s.SeatStatus</span>
                                        <span class="text-slate-400 font-mono truncate">@s.OrganizationId</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Children Management -->
                    <div>
                        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Children</h3>

                        <!-- Existing children -->
                        <div class="space-y-2 mb-3" id="children-list">
                            @if (!Model.Summary.Children.Any())
                            {
                                <div class="text-xs text-slate-400 italic">No children added yet.</div>
                            }
                            @foreach (var c in Model.Summary.Children)
                            {
                                <div class="bg-slate-50 rounded-xl px-3 py-2" id="child-@c.Id">
                                    <!-- Display row -->
                                    <div class="flex items-center justify-between" id="child-display-@c.Id">
                                        <div>
                                            <div class="text-sm font-medium text-slate-800">@c.DisplayName</div>
                                            <div class="text-xs text-slate-400">
                                                @(c.Age.HasValue ? $"Age {c.Age}" : "Age not set")
                                                &nbsp;·&nbsp;
                                                <span class="font-mono">@c.Id.ToString()[..8]…</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1.5 ml-2">
                                            <button type="button"
                                                    onclick="toggleEditChild('@c.Id')"
                                                    class="text-xs px-2 py-1 rounded-lg bg-indigo-100 text-indigo-700 hover:bg-indigo-200 transition-colors font-medium">
                                                Edit
                                            </button>
                                            <form method="post" asp-action="DeleteChild"
                                                  asp-route-userId="@Model.Summary.UserId"
                                                  asp-route-childId="@c.Id"
                                                  asp-route-query="@Model.Query"
                                                  onsubmit="return confirm('Delete @c.DisplayName?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="text-xs px-2 py-1 rounded-lg bg-red-100 text-red-600 hover:bg-red-200 transition-colors font-medium">
                                                    Del
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Edit row (hidden by default) -->
                                    <form method="post" asp-action="EditChild"
                                          asp-route-userId="@Model.Summary.UserId"
                                          asp-route-childId="@c.Id"
                                          asp-route-query="@Model.Query"
                                          id="child-edit-@c.Id"
                                          class="hidden mt-2 space-y-1.5">
                                        @Html.AntiForgeryToken()
                                        <input name="displayName" value="@c.DisplayName"
                                               class="w-full border border-slate-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-400"
                                               placeholder="Display name" required />
                                        <input name="age" value="@c.Age" type="number" min="1" max="18"
                                               class="w-full border border-slate-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-400"
                                               placeholder="Age (optional)" />
                                        <div class="flex gap-1.5">
                                            <button type="submit"
                                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition-colors font-medium">
                                                Save
                                            </button>
                                            <button type="button"
                                                    onclick="toggleEditChild('@c.Id')"
                                                    class="flex-1 text-xs px-3 py-1.5 rounded-lg bg-slate-200 text-slate-600 hover:bg-slate-300 transition-colors font-medium">
                                                Cancel
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>

                        <!-- Add Child form -->
                        <div class="border border-dashed border-slate-200 rounded-xl p-3">
                            <div class="text-xs font-semibold text-slate-500 mb-2">Add Child</div>
                            <form method="post" asp-action="CreateChild"
                                  asp-route-userId="@Model.Summary.UserId"
                                  asp-route-query="@Model.Query"
                                  class="space-y-1.5">
                                @Html.AntiForgeryToken()
                                <input name="displayName"
                                       class="w-full border border-slate-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-400 placeholder-slate-400"
                                       placeholder="Display name *" required />
                                <input name="age" type="number" min="1" max="18"
                                       class="w-full border border-slate-200 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-400 placeholder-slate-400"
                                       placeholder="Age (optional)" />
                                <button type="submit"
                                        class="w-full text-xs px-3 py-1.5 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors font-medium">
                                    + Add Child
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<script>
    function toggleEditChild(childId) {
        const display = document.getElementById('child-display-' + childId);
        const edit = document.getElementById('child-edit-' + childId);
        if (display && edit) {
            display.classList.toggle('hidden');
            edit.classList.toggle('hidden');
        }
    }
</script>
